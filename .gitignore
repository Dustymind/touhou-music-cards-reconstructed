# 上游只读参考与调研产物（约 200 MB，不进版本库）
.ref/

# Python / uv
tools/.venv/
.tools/
__pycache__/
*.py[cod]
.pytest_cache/
.uv/

# Node / 前端
node_modules/
.pnpm-store/
dist/
.vite/
*.tsbuildinfo
coverage/

# 端到端测试产物与浏览器（浏览器装进仓库，避开只读 $HOME；约 964 MB）
test-results/
playwright-report/
.playwright/
.playwright-browsers/

# 本地曲库助手配置（机器相关）
local-source.toml
# 本地曲库（音MAD 音频等，几十 MB 起）：只放本机，不进仓库
.music/
# 音MAD 素材归档（`pnpm media:pack` 的产物，约 324 MB）：发布成 Release 资产，不进仓库
otomads-media.tar.gz
# 音MAD 卡面（`pnpm media:pack` 会带上它；素材不入库，由用户自己放）
cards-otomads/
# S3：生成物不进仓库（dev 懒生成缓存 + Vite publicDir 的落点）
data/public/
.cache/
# 两个数据仓库的落点（REFACTOR-PLAN v2 §7.2/§11.4：不再是 submodule）：
#   本地开发：clone 到这里（或把 OTOMADS_DATA_DIR / CUSTOM_DATA_DIR 指到工作区根的独立克隆）；
#   CI/Vercel：把 Release 的数据集快照下到这里（scripts/build-datasets.mjs）。
data/otomads/
data/custom/
# S5：校验报告是本地工作记录（validate --report 现写现用），不随仓库分发
docs/reports/

# 编辑器 / 系统
.DS_Store
.vscode/*
!.vscode/settings.json
.idea/
*.swp

# wrangler 本地产物（现在部署在 GitHub Actions 里跑，本机不需要）
.wrangler/
